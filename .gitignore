# 環境変数・シークレット（ローカル設定はコミットしない）
.env
.env.*
!.env.example

# エディタ・IDE
.vscode/
.idea/

# macOS
.DS_Store

# Xcode
#
# gitignore 貢献者向け: Global/Xcode.gitignore, Objective-C.gitignore, Swift.gitignore も更新すること

## ユーザー設定
xcuserdata/

## Obj-C / Swift 固有
*.hmap

## アプリ配布物
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# SPM の依存ソースをリポジトリに含めない場合は次を有効化する
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
#
# Xcode が .xcworkspacedata と xcuserdata で自動生成するため、プロジェクトにパッケージ設定を追加していない限り通常は不要
# .swiftpm

.build/

# CocoaPods
#
# Pods は通常 .gitignore に含めない推奨だが、要否はプロジェクトで判断すること
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/
#
# Xcode ワークスペースのソースを含めない場合は次を有効化する
# *.xcworkspace

# Carthage
#
# Carthage の依存ソースを含めない場合は次を有効化する
# Carthage/Checkouts

Carthage/Build/

# fastlane
#
# スクリーンショットは git に置かず、必要時に fastlane で再生成するのが推奨
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

node_modules/
