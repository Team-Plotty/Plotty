{
  "name": "plotty-edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:supabase-shared": "rsync -a --delete src/ ../supabase/functions/_shared/plotty-edge/ && find ../supabase/functions/_shared/plotty-edge -name '*.ts' -exec sed -i '' 's/\\.js\"/\\.ts\"/g' {} +",
    "test:integration": "npm run build && node --test dist/tests/**/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
