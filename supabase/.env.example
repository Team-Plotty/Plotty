# Supabase Edge Functions ローカル用（plotty-api）
# 使い方:
#   cp supabase/.env.example supabase/.env.local
#   各値を Supabase Dashboard / Groq から埋める
# 参照: edge/src/core/env.ts, docs/09 §10.2
# 注意: supabase/.env.local は gitignore 済み。コミットしないこと。

# Supabase プロジェクト（Settings → API）
SUPABASE_URL=https://tqzrbdokgpunguawuyox.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# JWT 検証（Settings → API → JWT Settings）
SUPABASE_JWT_ISSUER=https://tqzrbdokgpunguawuyox.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Groq（console.groq.com）
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=10000
GROQ_RETRY_COUNT=1

# Groq 日次トークン上限（user 単位、UTC 日次リセット）
GROQ_DAILY_TOKEN_LIMIT=50000

APP_ENCRYPTION_KEY_BASE64=8C8xHmhIFKY3UaOyPVqVS2ea8jMSTe9LS5zZpEupA54=

# 短時間レート制限（chat 系）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- デプロイ（A4）---
# supabase secrets set --env-file supabase/.env.local
# supabase functions deploy plotty-api
